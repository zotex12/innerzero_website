# See https://help.github.com/articles/ignoring-files/ for more about ignoring files.

# dependencies
/node_modules
/.pnp
.pnp.*
.yarn/*
!.yarn/patches
!.yarn/plugins
!.yarn/releases
!.yarn/versions

# testing
/coverage

# next.js
/.next/
/out/

# generated sitemap (next-sitemap regenerates on every build)
public/sitemap*.xml

# production
/build

# misc
.DS_Store
*.pem

# debug
npm-debug.log*
yarn-debug.log*
yarn-error.log*
.pnpm-debug.log*

# env files (can opt-in for committing if needed)
.env*

# vercel
.vercel

# waitlist data
/data/

# typescript
*.tsbuildinfo
next-env.d.ts

# Front Matter CMS local state
.frontmatter/database/
.frontmatter/content/

# Scratch directory: throwaway smoke scripts, server logs, anything
# transient. Tools that need scratch space create files here at run
# time and clean up after themselves; nothing here should be tracked.
/scratch/

# Per-phase local packet drafted by the architect subagent; never committed.
WEBCLAUDE.local.md
